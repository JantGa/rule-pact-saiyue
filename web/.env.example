# Browser-visible Monad configuration
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_REGISTRY_ADDRESS=

# Server-only configuration
SESSION_SECRET=replace-with-at-least-32-random-characters
FAIRPLAY_DATA_DIR=.data
FAIRPLAY_PUBLIC_URL=http://localhost:3100

# Useful for a local demo without a deployed registry.
# Set to false in production so a match cannot start without Monad notarization.
FAIRPLAY_ALLOW_LOCAL_CHAIN=true

# Optional AI provider. Without a key, the built-in deterministic compiler is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

